# --- Database (local Docker Postgres by default) ---
# For production, swap in your Neon/Supabase connection string.
DATABASE_URL="postgres://ashvault:ashvault@localhost:5433/ashvault"

# --- Auth.js (NextAuth v5) ---
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL used when building share links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Rate limiting (optional) ---
# Leave these unset to use the built-in in-memory limiter (fine for dev/single instance).
# Set both to enable the distributed Upstash Redis limiter (recommended for Vercel).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
