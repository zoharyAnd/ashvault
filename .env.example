# --- Database (local Docker Postgres by default) ---
# For production, swap in your Neon/Supabase connection string.
DATABASE_URL="postgres://ashvault:ashvault@localhost:5433/ashvault"

# --- Auth.js (NextAuth v5) ---
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL used when building share links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Rate limiting (optional) ---
# Leave these unset to use the built-in in-memory limiter (fine for dev/single instance).
# Set both to enable the distributed Upstash Redis limiter (recommended for Vercel).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Seed / e2e test users ---
# Credentials that `pnpm db:seed` creates and the Playwright e2e suite logs in as.
# Intentionally blank: these are NOT committed. Fill them in your local .env, and
# provide them as CI secrets. Without them, db:seed creates no users and the e2e
# suite refuses to run. NEVER point these at real production accounts.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_USER1_EMAIL=""
SEED_USER1_PASSWORD=""
SEED_USER2_EMAIL=""
SEED_USER2_PASSWORD=""
